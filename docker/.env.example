# Public authority that appears in pairing QR codes.
# Use the server's public IP (with :port when not 80/443) or a domain.
# Leave empty to reuse the Host header sent by the DSH plugin.
PUBLIC_HOST=

# http or https. Set https when a TLS reverse proxy terminates TLS in front of
# this relay (and also set TRUST_PROXY=1), or when TLS_* files are configured.
PUBLIC_SCHEME=http

# Host port mapped to the relay's container port 8787.
RELAY_PORT=8787

# Concurrency and pairing limits.
MAX_TUNNELS=50
PAIR_TTL_MS=600000
PAIR_MAX_ATTEMPTS=5

# Optional shared secret; when set, enter the same value in the plugin's
# "Access token" field.
REGISTER_TOKEN=

# Trust X-Forwarded-For / X-Forwarded-Proto when behind a reverse proxy.
TRUST_PROXY=0
